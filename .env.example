# Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DOMAIN=squadia.example.com

# Postgres (self-hosted)
POSTGRES_PASSWORD=change-me-strong
DATABASE_URL=postgres://squadia:change-me-strong@postgres:5432/squadia

# Auth JWT (openssl rand -hex 32)
AUTH_JWT_SECRET=change-me-32-bytes-hex

# MinIO / S3
MINIO_ROOT_USER=squadia
MINIO_ROOT_PASSWORD=change-me-minio
S3_BUCKET=squadia
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=https://cdn.squadia.example.com

# Lovable AI Gateway
LOVABLE_API_KEY=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Meta Ads
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=
